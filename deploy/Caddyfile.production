# Canonical production logging config. Tests assert retention stays high.
# Access logs are kept indefinitely (compressed when rotated).
biggtoss.com {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 2000
			roll_keep_for 876000h
		}
		format json
	}
	reverse_proxy 127.0.0.1:8020
}

www.biggtoss.com, 129-225-99-227.sslip.io {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 2000
			roll_keep_for 876000h
		}
		format json
	}
	redir https://biggtoss.com{uri}
}

http://129.225.99.227 {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 2000
			roll_keep_for 876000h
		}
		format json
	}
	redir https://biggtoss.com{uri}
}
